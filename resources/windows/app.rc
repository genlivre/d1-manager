// Windows Resource File for D1 Manager
// Compile with: rc.exe app.rc

#include <winver.h>

// Application icon
1 ICON "icon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "D1 Manager Contributors"
            VALUE "FileDescription", "Production-safe Cloudflare D1 GUI Client"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "d1-manager"
            VALUE "LegalCopyright", "Copyright (c) 2024 D1 Manager Contributors. MIT License."
            VALUE "OriginalFilename", "d1-manager.exe"
            VALUE "ProductName", "D1 Manager"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
